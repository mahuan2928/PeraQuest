{"itemKind": "mcq", "contentVersion": "3ps-001", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "My brother ___ soccer every Sunday.", "choices": ["plays", "play", "playing", "is play"], "answer": "plays", "explanation": "主語が「彼」1 人のときは動詞に s を付けます。日本語では変わらないので、落としやすい形です。"}}
{"itemKind": "mcq", "contentVersion": "3ps-002", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "She ___ to school by bike.", "choices": ["goes", "go", "gos", "going"], "answer": "goes", "explanation": "go は s ではなく es を付けて goes になります。gos とは書きません。"}}
{"itemKind": "mcq", "contentVersion": "3ps-003", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "He ___ TV after dinner.", "choices": ["watches", "watch", "watchs", "watching"], "answer": "watches", "explanation": "ch で終わる語には es を付けます。watchs とはなりません。"}}
{"itemKind": "mcq", "contentVersion": "3ps-004", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "My mother ___ English at a school.", "choices": ["teaches", "teach", "teachs", "teaching"], "answer": "teaches", "explanation": "ch で終わるので es です。"}}
{"itemKind": "mcq", "contentVersion": "3ps-005", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "Ken ___ two dogs.", "choices": ["has", "have", "haves", "having"], "answer": "has", "explanation": "have は形が変わって has になります。haves とは言いません。"}}
{"itemKind": "mcq", "contentVersion": "3ps-006", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "My sister ___ math every night.", "choices": ["studies", "study", "studys", "studing"], "answer": "studies", "explanation": "「子音＋y」で終わる語は y を i に変えて es を付けます。studys ではありません。"}}
{"itemKind": "mcq", "contentVersion": "3ps-007", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "It ___ a lot in June.", "choices": ["rains", "rain", "raines", "raining"], "answer": "rains", "explanation": "天気の主語 it も三人称単数なので s が付きます。"}}
{"itemKind": "mcq", "contentVersion": "3ps-008", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "Tom and Ken ___ in Osaka.", "choices": ["live", "lives", "living", "are live"], "answer": "live", "explanation": "主語が 2 人なので s は付けません。直前の Ken が単数でも、主語全体で決めます。"}}
{"itemKind": "mcq", "contentVersion": "3ps-009", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "My father ___ up at six every morning.", "choices": ["gets", "get", "getts", "getting"], "answer": "gets", "explanation": "get up の get に s が付きます。up は変わりません。"}}
{"itemKind": "mcq", "contentVersion": "3ps-010", "knowledgePointRef": "grammar.third_person_s", "skillRef": "grammar", "payload": {"sentence": "She ___ her homework before dinner.", "choices": ["does", "do", "dos", "doing"], "answer": "does", "explanation": "do も es を付けて does になります。"}}
