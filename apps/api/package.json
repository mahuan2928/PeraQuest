  "dependencies": {
    "@peraquest/contracts": "*",
    "fastify": "^5.6.2",
    "jose": "6.2.10",
    "pg": "^8.23.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "vitest": "^4.0.8"
  }
}
