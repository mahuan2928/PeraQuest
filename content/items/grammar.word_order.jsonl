{"itemKind": "word_order", "contentVersion": "wo-101", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "わたしは毎朝コーヒーを飲みます。", "blocks": ["I", "drink", "coffee", "every", "morning"], "answers": [["I", "drink", "coffee", "every", "morning"]], "explanation": "英語は「だれが→する→何を→いつ」です。日本語の「毎朝」が先に来るのとは違います。"}}
{"itemKind": "word_order", "contentVersion": "wo-102", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "彼女は図書館で本を読みます。", "blocks": ["She", "reads", "books", "in", "the", "library"], "answers": [["She", "reads", "books", "in", "the", "library"]], "explanation": "場所は文の最後に置きます。"}}
{"itemKind": "word_order", "contentVersion": "wo-103", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "わたしたちは公園でサッカーをします。", "blocks": ["We", "play", "soccer", "in", "the", "park"], "answers": [["We", "play", "soccer", "in", "the", "park"]], "explanation": "「何を」が先、「どこで」があとです。"}}
{"itemKind": "word_order", "contentVersion": "wo-104", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "父は日曜日に車を洗います。", "blocks": ["My", "father", "washes", "the", "car", "on", "Sunday"], "answers": [["My", "father", "washes", "the", "car", "on", "Sunday"]], "explanation": "曜日には on を使い、文の最後に置きます。"}}
{"itemKind": "word_order", "contentVersion": "wo-105", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "彼は放課後に宿題をします。", "blocks": ["He", "does", "his", "homework", "after", "school"], "answers": [["He", "does", "his", "homework", "after", "school"]], "explanation": "「宿題をする」は do です。三人称単数なので does になります。"}}
{"itemKind": "word_order", "contentVersion": "wo-106", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "母は毎晩夕食を作ります。", "blocks": ["My", "mother", "cooks", "dinner", "every", "night"], "answers": [["My", "mother", "cooks", "dinner", "every", "night"]], "explanation": "dinner に冠詞は付けません。"}}
{"itemKind": "word_order", "contentVersion": "wo-107", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "わたしは友だちに手紙を書きます。", "blocks": ["I", "write", "a", "letter", "to", "my", "friend"], "answers": [["I", "write", "a", "letter", "to", "my", "friend"]], "explanation": "「だれに」は to で表し、「何を」のあとに置きます。"}}
{"itemKind": "word_order", "contentVersion": "wo-108", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "彼らは電車で東京へ行きます。", "blocks": ["They", "go", "to", "Tokyo", "by", "train"], "answers": [["They", "go", "to", "Tokyo", "by", "train"]], "explanation": "手段の「〜で」は by です。by train に冠詞は付けません。"}}
{"itemKind": "word_order", "contentVersion": "wo-109", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "わたしは英語をとても熱心に勉強します。", "blocks": ["I", "study", "English", "very", "hard"], "answers": [["I", "study", "English", "very", "hard"]], "explanation": "「どのように」は動詞と目的語のあとに置きます。"}}
{"itemKind": "word_order", "contentVersion": "wo-110", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "姉は毎日ピアノを練習します。", "blocks": ["My", "sister", "practices", "the", "piano", "every", "day"], "answers": [["My", "sister", "practices", "the", "piano", "every", "day"]], "explanation": "楽器には the を付けます。"}}
{"itemKind": "word_order", "contentVersion": "wo-111", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "わたしたちは教室をそうじします。", "blocks": ["We", "clean", "our", "classroom"], "answers": [["We", "clean", "our", "classroom"]], "explanation": "「だれが→する→何を」の 3 つだけの短い文です。"}}
{"itemKind": "word_order", "contentVersion": "wo-112", "knowledgePointRef": "grammar.word_order", "skillRef": "grammar", "payload": {"japanese": "彼は夕食後にテレビを見ます。", "blocks": ["He", "watches", "TV", "after", "dinner"], "answers": [["He", "watches", "TV", "after", "dinner"]], "explanation": "TV に冠詞は付けません。watch は三人称単数で watches になります。"}}
