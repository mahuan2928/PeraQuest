{"itemKind": "mcq", "contentVersion": "be-q-001", "knowledgePointRef": "grammar.be_question", "skillRef": "grammar", "payload": {"sentence": "___ you a junior high school student?", "choices": ["Are", "Is", "Am", "Do"], "answer": "Are", "explanation": "you が主語なので Are です。be動詞の疑問文では、be動詞を文の先頭に出します。"}}
{"itemKind": "mcq", "contentVersion": "be-q-002", "knowledgePointRef": "grammar.be_question", "skillRef": "grammar", "payload": {"sentence": "___ this your pen?", "choices": ["Is", "Are", "Am", "Does"], "answer": "Is", "explanation": "this は単数なので Is です。be動詞の文に Does は使いません。"}}
{"itemKind": "mcq", "contentVersion": "be-q-003", "knowledgePointRef": "grammar.be_question", "skillRef": "grammar", "payload": {"sentence": "___ they your classmates?", "choices": ["Are", "Is", "Am", "Do"], "answer": "Are", "explanation": "they は複数なので Are です。"}}
{"itemKind": "mcq", "contentVersion": "be-q-004", "knowledgePointRef": "grammar.be_question", "skillRef": "grammar", "payload": {"sentence": "___ he from Canada?", "choices": ["Is", "Are", "Am", "Does"], "answer": "Is", "explanation": "he は単数です。「〜出身ですか」は be動詞でたずねます。"}}
{"itemKind": "mcq", "contentVersion": "be-q-005", "knowledgePointRef": "grammar.be_question", "skillRef": "grammar", "payload": {"sentence": "\"Are you tired?\" — \"Yes, I ___.\"", "choices": ["am", "are", "is", "do"], "answer": "am", "explanation": "答えの主語が I になるので am です。たずねられた are をそのまま返しません。"}}
{"itemKind": "mcq", "contentVersion": "be-q-006", "knowledgePointRef": "grammar.be_question", "skillRef": "grammar", "payload": {"sentence": "\"Is she a teacher?\" — \"No, she ___.\"", "choices": ["isn't", "aren't", "am not", "doesn't"], "answer": "isn't", "explanation": "she は単数なので isn't です。短く答えるときも be動詞を使います。"}}
{"itemKind": "mcq", "contentVersion": "be-q-007", "knowledgePointRef": "grammar.be_question", "skillRef": "grammar", "payload": {"sentence": "___ your parents at home now?", "choices": ["Are", "Is", "Am", "Do"], "answer": "Are", "explanation": "parents は複数なので Are です。"}}
{"itemKind": "mcq", "contentVersion": "be-q-008", "knowledgePointRef": "grammar.be_question", "skillRef": "grammar", "payload": {"sentence": "___ it hot in your city?", "choices": ["Is", "Are", "Am", "Does"], "answer": "Is", "explanation": "天気の主語 it は単数なので Is です。"}}
