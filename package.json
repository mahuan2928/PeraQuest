{
  "name": "peraquest",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @peraquest/web",
    "dev:api": "npm run dev -w @peraquest/api",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:mobile": "npm run build -w @peraquest/web && npm run build -w @peraquest/mobile",
    "build:desktop": "npm run build -w @peraquest/desktop",
    "package:desktop": "npm run package -w @peraquest/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.6.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
