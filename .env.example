NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/peraquest
VOICE_FEATURE_PUBLIC_ENABLED=false
AI_VENDOR_APPROVED=false
CONSENT_VERSION_REQUIRED=v0
ALLOW_LEGACY_TEST_HEADERS=false
AUTH_PROVIDER=email_magic_link
AUTH_ISSUER=https://issuer.example.test
AUTH_AUDIENCE=peraquest-api
AUTH_JWKS_URL=https://issuer.example.test/.well-known/jwks.json
AUTH_CLOCK_SKEW_SECONDS=60
AUTH_MAX_TOKEN_TTL_SECONDS=3600
AUTH_JWKS_CACHE_MAX_AGE_MS=600000
AUTH_JWKS_COOLDOWN_MS=30000
AUTH_JWKS_TIMEOUT_MS=5000
